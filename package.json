{
  "name": "zed-android-port",
  "version": "0.1.0",
  "description": "Zed on Android. Rust on aarch64, sounded portable. Laughed about it. Kept going.",
  "main": "crates/gpui_android/src/lib.rs",
  "scripts": {
    "dev": "cargo run --release --example zed_android",
    "test": "cargo test",
    "typecheck": "cargo check",
    "lint": "cargo clippy -- -D warnings",
    "fmt": "cargo fmt",
    "build": "cargo build --release",
    "bin": "cargo build --bin zdroid --release"
  },
  "dependencies": {
    "gpui_android": "0.1.0",
    "zed": "0.1.0"
  },
  "devDependencies": {
    "rustfmt": "^2.0.0",
    "clippy": "^0.0.302"
  },
  "bin": {
    "zdroid": "crates/gpui_android/examples/zed_android/src/main.rs"
  },
  "private": true,
  "type": "module"
}
